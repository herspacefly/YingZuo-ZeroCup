{
  "schemaVersion": 1,
  "facts": [
    {
      "id": "culture-material",
      "kind": "culture",
      "text": "中国非遗网的工艺介绍记载皮料加工成半透明状后刻制上彩。",
      "sourceIds": [
        "C2"
      ]
    },
    {
      "id": "culture-light-screen",
      "kind": "culture",
      "text": "皮影戏借灯光照射影人，在影窗上表演故事。",
      "sourceIds": [
        "C2"
      ]
    },
    {
      "id": "culture-components",
      "kind": "culture",
      "text": "中国非遗网介绍影人分头、身、四肢相接，并在身部和两手安装三根操纵杆。",
      "sourceIds": [
        "C2"
      ]
    },
    {
      "id": "culture-ensemble",
      "kind": "culture",
      "text": "河北省文旅厅的冀南皮影介绍记载操纵随唱白、伴奏配合，演员各司其事又相互配合；不能据此规定所有班社的人数。",
      "sourceIds": [
        "C3"
      ]
    },
    {
      "id": "culture-repertoire",
      "kind": "culture",
      "text": "河北省文旅厅的冀南皮影资料将《劈山救母》列入单本剧。",
      "sourceIds": [
        "C3"
      ]
    },
    {
      "id": "culture-performance",
      "kind": "culture",
      "text": "2013年中国文艺网所载展演综述记录唐山市皮影剧团的《劈山救母》演出。",
      "sourceIds": [
        "C4"
      ]
    },
    {
      "id": "culture-opera-story",
      "kind": "culture",
      "text": "文旅部这则京剧《宝莲灯》简介写有沉香学艺并劈山救母；它是京剧版本简介，不是皮影戏本。",
      "sourceIds": [
        "C5"
      ]
    },
    {
      "id": "culture-tangshan",
      "kind": "culture",
      "text": "中国非遗网介绍唐山皮影使用驴皮，唱腔以乐亭方言为基础。",
      "sourceIds": [
        "C2"
      ]
    },
    {
      "id": "culture-jianghan",
      "kind": "culture",
      "text": "中国非遗网介绍江汉平原皮影影人以影大见长，唱腔以歌腔、渔鼓腔为主。",
      "sourceIds": [
        "C2"
      ]
    },
    {
      "id": "culture-huayin",
      "kind": "culture",
      "text": "华阴老腔项目页面介绍陕西华阴的该剧种采用一人唱、众人帮合的拖腔。",
      "sourceIds": [
        "C7"
      ]
    },
    {
      "id": "model-layers",
      "kind": "model",
      "text": "三维灯影展台固定影偶，以拖灯观察色影的偏移与尺度；它不模拟真实皮料和颜料的完整光学性质。",
      "sourceIds": []
    },
    {
      "id": "model-carving",
      "kind": "model",
      "text": "独立莲灯皮样通过八处可操作孔隙比较留白与成影，不附加到角色服装，也不等同于真实刀法训练。",
      "sourceIds": []
    },
    {
      "id": "model-joints",
      "kind": "model",
      "text": "十部件、九关节、三杆和角度限制是本作简化数字模型，不是统一的传统结构标准。",
      "sourceIds": []
    },
    {
      "id": "model-projection",
      "kind": "model",
      "text": "灯位与偶幕距离实验复用本作简化几何，仅比较位置与尺度，不是完整光学仿真。",
      "sourceIds": []
    },
    {
      "id": "model-ensemble",
      "kind": "model",
      "text": "四项可开关、调时的职责共同驱动双人排演；节拍以圆环呈现，不规定班社人数或替代真实唱腔伴奏。",
      "sourceIds": []
    },
    {
      "id": "original-motif",
      "kind": "original",
      "text": "展馆刻纹样片为本作独立数字示意，只用于比较留白与成影，不附加到角色服装。",
      "sourceIds": []
    },
    {
      "id": "original-adaptation",
      "kind": "original",
      "text": "母子灯下记忆、灯火呼应、先呼唤或先开山、五种终章及新写对白属于本作原创改编。",
      "sourceIds": []
    },
    {
      "id": "original-regions",
      "kind": "original",
      "text": "本作使用混合原创造型，不声称复原唐山、江汉平原或华阴的任何地方流派。",
      "sourceIds": []
    }
  ]
}
